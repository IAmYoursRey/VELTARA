# VELTARA.ID Environment Configuration Template
# Untuk Pengembangan Lokal: Salin file ini menjadi .env.local (frontend) dan backend/.env (backend)
# Untuk Penerapan Vercel Production: Lihat .env.vercel.example

# -------------------------------------------------------------
# APPLICATION RUNTIME
# -------------------------------------------------------------
# Opsi: development | test | production
APP_ENV=development

# -------------------------------------------------------------
# FRONTEND / BFF CONFIGURATION
# -------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_ENV=development
API_BASE_URL=http://127.0.0.1:8000

# -------------------------------------------------------------
# AUTHENTICATION & JWT SECURITY
# -------------------------------------------------------------
JWT_SECRET_KEY=veltara-dev-secret-key-32-bytes-minimum-length-req
JWT_ALGORITHM=HS256
JWT_ISSUER=veltara.id
JWT_AUDIENCE=veltara.id
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# -------------------------------------------------------------
# COOKIE CONFIGURATION
# -------------------------------------------------------------
COOKIE_NAME=veltara_session
REFRESH_COOKIE_NAME=veltara_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# -------------------------------------------------------------
# CSRF PROTECTION
# -------------------------------------------------------------
CSRF_COOKIE_NAME=veltara_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# -------------------------------------------------------------
# IDENTIFIER LOOKUP PRIVACY
# -------------------------------------------------------------
# Salt/pepper untuk HMAC identifier lookup (melindungi privasi NISN/NIP)
IDENTIFIER_LOOKUP_PEPPER=veltara-identifier-lookup-pepper-v1
CV_VERIFICATION_TOKEN_PEPPER=veltara-cv-token-pepper-v1

# -------------------------------------------------------------
# DATABASE (NEON POSTGRESQL / LOCAL SQLITE)
# -------------------------------------------------------------
# Di lokal dev: bisa menggunakan SQLite bawaan (sqlite+aiosqlite:///./test_veltara.db)
# atau langsung menghubungkan ke database Neon (gratis):
DATABASE_URL=sqlite+aiosqlite:///./test_veltara.db
REPOSITORY_BACKEND=postgres

# -------------------------------------------------------------
# OBJECT STORAGE (LOCAL / VERCEL BLOB / S3)
# -------------------------------------------------------------
# Opsi: local (pengembangan lokal) | vercel_blob (produksi Vercel)
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=backend/storage_data

# Konfigurasi Vercel Blob (bila menggunakan Vercel Blob di cloud):
BLOB_BROKER_HMAC_SECRET=veltara-blob-broker-dev-secret-32-bytes-min
BLOB_BROKER_TOKEN_TTL_SECONDS=60
BLOB_DOWNLOAD_URL_TTL_SECONDS=300

# -------------------------------------------------------------
# FREE-TIER STORAGE PROTECTION
# -------------------------------------------------------------
FREE_TIER_MODE=true
STORAGE_SOFT_LIMIT_BYTES=209715200

# -------------------------------------------------------------
# DEMO ACCOUNTS & PUBLIC APP
# -------------------------------------------------------------
ENABLE_DEMO_AUTH=true
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
