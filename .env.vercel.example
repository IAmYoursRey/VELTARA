# VELTARA.ID — Authoritative Vercel Free-Tier Environment Configuration Template
# Salin atau atur variabel lingkungan ini di menu Project Settings > Environment Variables di Dashboard Vercel

# -------------------------------------------------------------
# APPLICATION RUNTIME
# -------------------------------------------------------------
APP_ENV=production
NODE_ENV=production

# -------------------------------------------------------------
# DATABASE (NEON POSTGRESQL — FREE TIER)
# -------------------------------------------------------------
# String koneksi Pooled Neon dengan prefix driver asyncpg:
# Ambil dari console.neon.tech -> Connection Details -> Pooled Connection
# Format: postgresql+asyncpg://neondb_owner:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_NEON_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
REPOSITORY_BACKEND=postgres

# Serverless Connection Pooling (Optimasi cold-start untuk Neon PgBouncer)
DB_POOL_CLASS=queue
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0

# -------------------------------------------------------------
# FILE STORAGE (VERCEL BLOB — PRIVATE STORAGE)
# -------------------------------------------------------------
OBJECT_STORAGE_PROVIDER=vercel_blob

# Kunci rahasia HMAC khusus broker otorisasi FastAPI <-> Next.js Blob (minimal 32 karakter acak)
# JANGAN gunakan nilai yang sama dengan JWT_SECRET_KEY:
BLOB_BROKER_HMAC_SECRET=generate-at-least-32-character-random-hex-broker-secret
BLOB_BROKER_TOKEN_TTL_SECONDS=60
BLOB_DOWNLOAD_URL_TTL_SECONDS=300

# Di Vercel Production: Vercel Blob OIDC (VERCEL_OIDC_TOKEN) disuntikkan secara otomatis saat Anda menautkan Blob Store.
# Fallback opsional (untuk local dev / manual token):
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# -------------------------------------------------------------
# FREE-TIER STORAGE PROTECTION
# -------------------------------------------------------------
FREE_TIER_MODE=true
# Soft limit perlindungan kuota gratis Vercel Blob (default 200 MB dalam bytes)
STORAGE_SOFT_LIMIT_BYTES=209715200

# -------------------------------------------------------------
# SECURITY & AUTHENTICATION SECRETS
# -------------------------------------------------------------
# Kunci rahasia minimal 32 karakter acak dengan entropi tinggi
JWT_SECRET_KEY=generate-at-least-32-character-random-hex-jwt-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=veltara.id
JWT_AUDIENCE=veltara.id

# Salt/pepper HMAC untuk anonimisasi NISN / NIP / NUPTK siswa & guru di database
IDENTIFIER_LOOKUP_PEPPER=generate-a-unique-32-byte-secret-lookup-pepper

# Salt/pepper untuk hash token verifikasi publik QR CV Digital
CV_VERIFICATION_TOKEN_PEPPER=generate-a-unique-32-byte-secret-cv-token-pepper

# Cookie Configuration (Vercel Production menggunakan HTTPS)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ENABLE_DEMO_AUTH=false
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# -------------------------------------------------------------
# PUBLIC APP URL & CORS
# -------------------------------------------------------------
# Set ke URL domain Vercel Anda (tanpa tanda garis miring di akhir)
PUBLIC_APP_URL=https://veltara.vercel.app
ALLOWED_ORIGINS=https://veltara.vercel.app
